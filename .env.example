# Neon Postgres connection string (create a project at https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/vvip?sslmode=require"

# Random secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
