# Neon Postgres connection string (create a project at https://neon.tech)
DATABASE_URL=""

# Random secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Used once by `npm run db:seed` to create the first admin login. Change the
# password after logging in for the first time.
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# Needed for admin image uploads (News/Events cover images) to work, both in
# local dev and in production. Find these in your Netlify account:
#   NETLIFY_SITE_ID  -- Site settings -> General -> Site details -> Site ID
#   NETLIFY_API_TOKEN -- User settings -> Applications -> New access token
NETLIFY_SITE_ID=""
NETLIFY_API_TOKEN=""
